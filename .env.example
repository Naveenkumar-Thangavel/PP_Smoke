# Environment Configuration for PP_Smoke Tests
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to Git (it's in .gitignore)
# For GitHub Actions, use GitHub Secrets instead

# Application URL for testing
BASE_URL=https://your-app-url.com

# Test user credentials
LOGIN_EMAIL=test.user@example.com
LOGIN_PASSWORD=YourSecurePassword123

# Optional: Debugging
# PLAYWRIGHT_HEADLESS=false    # Run browser in visible mode
# PLAYWRIGHT_SLOW_MO=1000      # Slow down actions by 1000ms
# DEBUG=pw:api                 # Enable Playwright debug logs
